# Supabase (create a project, then paste these from Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Auth Admin API key. Must be from the SAME project as NEXT_PUBLIC_SUPABASE_URL.
# Dashboard → Project Settings → API Keys. Prefer the secret key (sb_secret_…).
# Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# CMS admin — used by `yarn seed` to create/update the Auth user.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Prisma: transaction pooler (6543) for the app, session/direct (5432) for migrate/db pull.
# Dashboard → Connect → ORM (Prisma). Append ?pgbouncer=true to DATABASE_URL.
# DATABASE_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Newer Supabase projects may show a publishable key instead of the anon key.
# Either one works — the app reads PUBLISHABLE_KEY first, then ANON_KEY.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Existing contact form (unchanged)
# CONTACT_WEBHOOK_URL=
